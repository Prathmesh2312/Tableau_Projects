                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#03c4a1'>____________________________________________________________________</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run fontalignment='1' fontcolor='#f5f5f5'>This HR Dashboard uses dataset generated using </run>
                    <run bold='true' fontalignment='1' fontcolor='#03c4a1'>ChatGPT</run>
                    <run fontalignment='1' fontcolor='#f5f5f5'> and </run>
                    <run bold='true' fontalignment='1' fontcolor='#03c4a1'>Faker</run>
                    <run fontalignment='1' fontcolor='#f5f5f5'> library.</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#03c4a1'>__________________________________________________________________________</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#03c4a1'>Author</run>
