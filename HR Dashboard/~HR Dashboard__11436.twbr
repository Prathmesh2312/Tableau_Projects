      <aliases enabled='yes' />
      <column caption='% Total Terminated' datatype='real' default-format='p0%' name='[% Total Hired (copy)_804736962571292690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_804736962192093185] / TOTAL([Calculation_804736962192093185])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Total Hired' datatype='real' default-format='p0%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_804736962191859712] / TOTAL([Calculation_804736962191859712])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Hired' datatype='integer' name='[Calculation_804736962191859712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Employee_ID])' />
      </column>
      <column caption='Total Terminated' datatype='integer' name='[Calculation_804736962192093185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF NOT ISNULL([Termdate]) THEN [Employee_ID] END)' />
      </column>
      <column caption='Total Active' datatype='integer' name='[Calculation_804736962193764354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF ISNULL([Termdate]) THEN [Employee_ID] END)' />
      </column>
      <column caption='Location' datatype='string' name='[Calculation_804736962200387589]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [State]&#13;&#10;    WHEN &quot;New York&quot; THEN &quot;HQ&quot;&#13;&#10;    ELSE &quot;Branch&quot;&#13;&#10;END' />
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_804736962207797257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&quot;year&quot;,[Birthdate],TODAY())' />
      </column>
      <column caption='Age Groups' datatype='string' name='[Calculation_804736962208743434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_804736962207797257] &lt; 25 THEN &quot;&gt;25&quot;&#13;&#10;ELSEIF [Calculation_804736962207797257] &gt;= 25 AND  [Calculation_804736962207797257] &lt; 35 THEN &quot;25-34&quot;&#13;&#10;ELSEIF [Calculation_804736962207797257] &gt;= 35 AND  [Calculation_804736962207797257] &lt; 45 THEN &quot;35-44&quot;&#13;&#10;ELSEIF [Calculation_804736962207797257] &gt;= 45 AND  [Calculation_804736962207797257] &lt; 55 THEN &quot;45-54&quot;&#13;&#10;ELSEIF  [Calculation_804736962207797257] &gt;= 55 THEN &quot;55+&quot;&#13;&#10;END' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_804736962522361867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Termdate]) THEN &quot;Hired&quot;&#13;&#10;ELSE &quot;Terminated&quot;&#13;&#10;END' />
      </column>
      <column caption='Highlight Max' datatype='boolean' name='[Calculation_804736962527293452]' role='measure' type='nominal'>
        <calculation class='tableau' formula='WINDOW_MAX([Calculation_804736962191859712]) = [Calculation_804736962191859712]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top 2 Jobs' datatype='boolean' name='[Calculation_804736962573033491]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK([Calculation1]) &lt;= 2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
